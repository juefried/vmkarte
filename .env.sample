# Compose-Projektname. Haelt Container, Netzwerke und Traefik-Namen vom
# Produktivprojekt getrennt.
COMPOSE_PROJECT_NAME=vmkarte-oauth-test

# Produktiv erzeugte Kartendaten. Wird ausschliesslich read-only eingebunden.
VMKARTE_SHARED_DATA_DIR=/home/docker.run/velomobilforum-karte/docker/webserver/www_data/shared

# Sichtbare Test-Kennzeichnung in Browser-Titel und PWA-Manifest.
TEST_APP_TITLE=Velomobilkarte Test
TEST_APP_SHORT_NAME=VMKarte Test

# TLS endet an Traefik; das Session-Cookie wird daher als Secure gesetzt.
COOKIE_SECURE=true

# OAuth2-Anmeldung ueber das Velomobilforum. Das Client-Secret steht nicht
# hier, sondern in config/oauth_client_secret und wird als Docker-Secret
# eingebunden.
OAUTH_CLIENT_ID=
OAUTH_AUTHORIZE_URL=https://www.velomobilforum.de/forum/index.php?oauth2/authorize
OAUTH_TOKEN_URL=https://www.velomobilforum.de/forum/index.php?api/oauth2/token
OAUTH_USERINFO_URL=https://www.velomobilforum.de/forum/index.php?api/me/
OAUTH_SCOPE=user:read
OAUTH_REDIRECT_URI=https://karte-test.jfr-service.de/auth/forum/callback

# Testphase: Loginseite mit OAuth-Button anzeigen. Fuer nahtlose SSO spaeter
# auf true setzen; dann leitet /login direkt zum Forum weiter.
OAUTH_AUTO_REDIRECT=false
