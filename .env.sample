# Compose-Projektname. Haelt Container, Netzwerke und Traefik-Namen vom
# Produktivprojekt getrennt.
COMPOSE_PROJECT_NAME=vmkarte-oauth-test

# Produktiv erzeugte Kartendaten. Wird ausschliesslich read-only eingebunden.
VMKARTE_SHARED_DATA_DIR=/home/docker.run/velomobilforum-karte/docker/webserver/www_data/shared

# Sichtbare Test-Kennzeichnung in Browser-Titel und PWA-Manifest.
TEST_APP_TITLE=Velomobilkarte Test
TEST_APP_SHORT_NAME=VMKarte Test

# TLS endet an Traefik; das Session-Cookie wird daher als Secure gesetzt.
COOKIE_SECURE=true

# OAuth2 ist noch nicht implementiert. Diese Werte sind nur vorbereitete
# Laufzeitplatzhalter und werden vom Auth-Service derzeit nicht gelesen.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_REDIRECT_URI=https://karte-test.jfr-service.de/auth/forum/callback
