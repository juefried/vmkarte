services:

  web:
    build:
      context: docker/webserver
      args:
        APP_VERSION: ${APP_VERSION:-}
        BUILD_DATE: ${BUILD_DATE:-}
    # Only reachable through the local reverse proxy. Remove this mapping if the
    # proxy runs in the same Docker network (for example Traefik) and use
    # web:8080 with loadbalancer.server.port=8080 instead.
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - ./docker/webserver/www_data/shared:/www_data/shared:ro
    depends_on:
      auth:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    restart: unless-stopped

  auth:
    build:
      context: docker/auth
    image: localhost/${COMPOSE_PROJECT_NAME}_auth:latest
    # No published port: nginx reaches the auth service via the internal network.
    expose:
      - "8080"
    environment:
      PASSWORD_FILE: /run/secrets/htpasswd
      SESSION_KEY_FILE: /run/secrets/session_signing_key
      # Optional: Impressum und Datenschutz. Erst aktivieren, wenn
      # config/impressum.json und config/legal/*.html vorhanden sind.
      # IMPRINT_FILE: /run/secrets/imprint
      # LEGAL_DIR: /app/legal
    # volumes:
    #   - ./config/legal:/app/legal:ro
    secrets:
      - htpasswd
      - session_signing_key
      # - imprint
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8080/health"]
      interval: 30s
      timeout: 3s
      retries: 3
      start_period: 5s
    restart: unless-stopped

  cron:
    build:
      context: .
      dockerfile: docker/cron/Dockerfile
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - ./config/config.json:/app/config.json
      - ./config/cache_config.json:/app/cache_config.json:ro
      - ./volumes/cron/cache:/app/cache
      - ./docker/webserver/www_data/shared:/app/shared
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    restart: unless-stopped

secrets:
  htpasswd:
    file: ./config/.htpasswd
  session_signing_key:
    file: ./config/session_signing_key
  # imprint:
  #   file: ./config/impressum.json
